# Conexión PostgreSQL
DB_NAME=nombre_de_base_de_datos
DB_USER=usuario_postgres
DB_PASS=contraseña_postgres
DB_HOST=localhost
DB_PORT=5432

# Autenticación
# Genera un secreto aleatorio de al menos 32 bytes para cada entorno.
JWT_SECRET=reemplazar_por_un_secreto_aleatorio_de_32_bytes_o_mas
ADMIN_EMAIL=admin@helicenter.com
ADMIN_PASSWORD=reemplazar_por_una_contraseña_segura_de_12_caracteres_o_mas

# Correo saliente (formulario de contacto y alta de usuarios)
SMTP_USER=tu_usuario@correo.com
SMTP_PASSWORD=tu_nueva_contrasena
SMTP_PASS=
SMTP_PORT=
SMTP_SECURE=true

# Entorno HTTP
NODE_ENV=development
PORT=4173
